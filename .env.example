# Copy to .env and adjust. Every variable has a working default.

# Neo4j
KHG_NEO4J_URI=bolt://localhost:7687
KHG_NEO4J_USER=neo4j
KHG_NEO4J_PASSWORD=graphrag-demo

# Ollama — local models (CPU is enough; qwen2.5:1.5b is faster, qwen2.5:7b is better)
KHG_OLLAMA_URL=http://localhost:11434
KHG_LLM_MODEL=qwen2.5:3b
KHG_EMBED_MODEL=nomic-embed-text
KHG_EMBED_DIM=768
# nomic-embed-text uses task prefixes; set both to empty for other embedding models
KHG_EMBED_DOC_PREFIX="search_document: "
KHG_EMBED_QUERY_PREFIX="search_query: "

# Retrieval
KHG_TOP_K=5
KHG_EXPAND_K=5
KHG_MAX_FACTS=8
KHG_REQUIRE_CITATION=true

# Langfuse (optional). Create a project at http://localhost:3000 and paste its keys.
KHG_LANGFUSE_PUBLIC_KEY=
KHG_LANGFUSE_SECRET_KEY=
KHG_LANGFUSE_HOST=http://localhost:3000

# TruLens judge model (optional; empty = same as KHG_LLM_MODEL)
KHG_JUDGE_MODEL=
